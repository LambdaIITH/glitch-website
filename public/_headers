# Read by both Cloudflare Pages and Netlify. A request gets the headers of every rule it matches.

# Security headers. Script and style rules stay out on purpose: stacked CSP policies only add restrictions,
# so a header-level script-src would block the site's own inline scripts.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Let the SciTech site (or anyone) fetch the JSON feeds from the browser.
/api/*
  Access-Control-Allow-Origin: *

# Built assets have hashed names, so they can be cached for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
