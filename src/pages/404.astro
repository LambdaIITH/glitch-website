---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Dead end" description="This page doesn't exist." noindex>
  <div class="wrap page">
  <h1><span class="glitch" data-text="Dead End" data-glitch-load>Dead End</span></h1>
  <p class="lead">There's nothing in this room. The page may have moved, or the link was wrong.</p>
  <p><a class="btn" href="/">Back to the Start <Icon name="arrow" /></a></p>
  <p>Or try <a href="/games/">Games</a>, <a href="/events/">Events</a>, the <a href="/scoreboard/">Hall of Records</a> or <a href="/join/">Join</a>.</p>
  </div>
</Base>
