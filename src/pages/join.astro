---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import club from '../lib/club';

const tracks = [
  { name: 'Glitch Blue', what: 'The technical side: programming our games.' },
  { name: 'Glitch Red', what: 'Design: characters, game assets and UI.' },
  { name: 'Glitch Neon', what: 'Esports: running our tournaments and leagues.' },
];
const contacts = [
  { label: 'Discord', href: club.discord, text: 'Glitch Basement', icon: 'discord' },
  { label: 'Email', href: `mailto:${club.email}`, text: club.email, icon: 'mail' },
  { label: 'itch.io', href: club.itch, text: 'glitchiith.itch.io', icon: 'itch' },
  { label: 'Instagram', href: club.instagram, text: '@glitch.iith', icon: 'instagram' },
  { label: 'LinkedIn', href: club.linkedin, text: 'glitch-iith', icon: 'linkedin' },
  { label: 'GitHub', href: club.github, text: 'glitchiith', icon: 'github' },
] as const;
---
<Base title="Join" current="join" description="How to join Glitch, IIT Hyderabad's video game club: the Discord, recruitment tracks and who to contact.">
  <div class="wrap page">
  <h1><span class="glitch" data-text="Join Glitch" data-glitch-load>Join Glitch</span></h1>
  <p class="lead">
    The easiest way in is our Discord server, the Glitch Basement. Club news also goes out by mail to every student.
  </p>
  <p><a class="btn" href={club.discord}>Join the Discord <Icon name="external" /></a></p>

  <section>
    <h2>How joining works</h2>
    <p>Most of our events, jams and workshops are open to everyone at IITH; you don't need to be a member to take part.</p>
    <p>
      To join the team, watch for a recruitment round; we announce them by mail and on Discord. There are three tracks:
    </p>
    <dl class="tracks">
      {tracks.map((t) => (<><dt>{t.name}</dt><dd>{t.what}</dd></>))}
    </dl>
    <p>Recent rounds asked you to make something on a theme we set: a playable game, or a set of game assets.</p>
  </section>

  <section>
    <h2>Leads</h2>
    <ul class="leads">
      {club.leads.map((l) => (
        <li><strong>{l.name}</strong><br /><span class="soft">{l.role}</span></li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Contact</h2>
    <dl class="contacts">
      {contacts.map((c) => (<><dt><BrandIcon name={c.icon} />{c.label}</dt><dd><a href={c.href}>{c.text}</a></dd></>))}
    </dl>
  </section>
  </div>
</Base>

<style>
  section { margin-top: var(--u8); }
  .leads li { padding: var(--u2); background: var(--panel); }
  .tracks, .contacts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--u1) var(--u4);
    margin: 0 0 var(--u2);
  }
  dt { font-weight: 700; display: inline-flex; align-items: center; gap: var(--u1); }
  dt :global(.brand) { width: 22px; height: 22px; color: var(--amber); }
  dd { margin: 0; overflow-wrap: anywhere; }
  .tracks dt { font: 900 1.6rem/1.1 var(--font-display); color: var(--amber); }
  @media (max-width: 559px) {
    .tracks { grid-template-columns: 1fr; gap: 0; }
    .tracks dd { margin-bottom: var(--u2); }
  }
  .leads {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--u4);
  }
  @media (min-width: 768px) {
    .leads { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
