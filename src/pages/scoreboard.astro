---
import Base from '../layouts/Base.astro';
import Scoreboard from '../components/Scoreboard.astro';
import cogito from '../data/cogito.json';
---
<Base title="Hall of records" current="scoreboard" description="Final standings from Glitch's competitive games, starting with Cogito at Milan 2026.">
  <div class="wrap page">
  <h1><span class="glitch" data-text="Hall of records" data-glitch-load>Hall of records</span></h1>
  <p class="lead">Final standings from our competitive games. Every board here is frozen.</p>

  <section id="cogito" class="record">
    <h2>Cogito <span class="soft">· Milan 2026</span></h2>
    <p>
      Final standings, frozen when the game came down on 4 October 2026. Each hostel's top 50 scores counted toward its
      total, and the top 20 players made the main board. <a href="/games/cogito/">About Cogito</a>
    </p>
    <div class="boards">
      <Scoreboard
        caption="Hostel standings"
        columns={[
          { key: 'hostel', label: 'Hostel' },
          { key: 'players', label: 'Players counted', num: true, sub: 'players counted' },
          { key: 'score', label: 'Total score', num: true },
        ]}
        rows={cogito.hostels}
      />
      <Scoreboard
        caption="Top 20 players"
        columns={[
          { key: 'name', label: 'Name' },
          { key: 'hostel', label: 'Hostel', sub: '' },
          { key: 'score', label: 'Best score', num: true },
        ]}
        rows={cogito.players}
      />
    </div>
  </section>
  </div>
</Base>

<style>
  .record { margin-top: var(--u8); }
  .boards {
    display: grid;
    gap: var(--u8);
    margin-top: var(--u4);
  }
  @media (min-width: 1100px) {
    .boards { grid-template-columns: 1fr 1fr; gap: var(--u6); align-items: start; }
  }
</style>
