---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { image } from '../lib/images';

interface Game {
  slug: string; title: string; tagline?: string; genre: string; platforms: string[];
  page?: string; link?: string; image: string; focus?: string;
}
interface Props { game: Game }
const { game: g } = Astro.props;
const href = g.page || g.link || '/games/';
const external = !g.page && !!g.link;
---
<a class="tile" href={href} data-tilt data-glitch-hover data-reveal data-dissolve>
  <div class="art crt">
    <Image class="glitch-img" style={g.focus ? `object-position:${g.focus}` : undefined} src={image(g.image)} alt="" widths={[400, 800]} sizes="(min-width: 1100px) 260px, (min-width: 600px) 33vw, 100vw" />
  </div>
  <div class="info">
    <p class="label">{g.genre} · {g.platforms.join(', ')}</p>
    <h3><span class="glitch" data-text={g.title}>{g.title}</span></h3>
    {g.tagline && <p class="tagline small soft">{g.tagline}</p>}
    <span class="go small">{external ? 'On itch.io' : 'Open'} <Icon name={external ? 'external' : 'arrow'} /></span>
  </div>
</a>

<style>
  .tile {
    position: relative; display: grid; grid-template-rows: auto 1fr;
    background: var(--panel); color: var(--text); text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease, background 0.2s;
  }
  .tile::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.2s;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.09), transparent 50%);
  }
  .tile:hover { background: var(--panel-2); }
  .tile:hover::after { opacity: 1; }
  .art { aspect-ratio: 4 / 3; background: var(--bg); }
  .art :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s steps(4); }
  .tile:hover .art :global(img) { transform: scale(1.05); }
  .info { display: flex; flex-direction: column; gap: 6px; padding: var(--u2); }
  .info p { margin: 0; }
  h3 { margin: 0; font-size: 1.375rem; }
  .tile:hover h3 { color: var(--amber); }
  .go { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: var(--u1); color: var(--amber); font-weight: 700; }
  .go :global(.icon) { width: 11px; }
  @media (prefers-reduced-motion: reduce) {
    .tile, .art :global(img) { transition: none; }
    .tile:hover .art :global(img) { transform: none; }
  }
</style>
