---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props { current?: string }
const { current } = Astro.props;
const nav = [
  { id: 'games', href: '/games/', label: 'Games' },
  { id: 'events', href: '/events/', label: 'Events' },
  { id: 'scoreboard', href: '/scoreboard/', label: 'Scoreboard' },
  { id: 'join', href: '/join/', label: 'Join' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" data-glitch-hover>
      <Image class="glitch-img" src={logo} alt="" width={44} densities={[1, 2]} loading="eager" />
      <span class="glitch" data-text="Glitch">Glitch</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="sound" type="button" data-sound-toggle aria-pressed="false" hidden>
      <svg viewBox="0 0 11 11" width="22" height="22" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
        <path d="M0 4h2v3H0zM2 3h1v5H2zM3 2h1v7H3zM4 1h1v9H4zM6 4h1v3H6zM7 3h1v1H7zM7 7h1v1H7zM8 2h1v1H8zM8 8h1v1H8zM9 3h1v5H9z" />
      </svg>
      <span data-sound-label>Sound Off</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(20 17 19 / 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--u1) var(--u3); padding-block: var(--u1); }
  .brand {
    display: inline-flex; align-items: center; gap: var(--u1); margin-right: auto;
    color: var(--text); text-decoration: none;
    font: 700 1.625rem/1 var(--font-heading);
  }
  .brand :global(img) { width: 36px; height: auto; }
  ul { display: flex; flex-wrap: wrap; gap: 0 var(--u3); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-block; padding-block: var(--u1);
    color: var(--text); font-weight: 700; text-decoration: none;
  }
  nav a:hover, nav a[aria-current] { color: var(--amber); }
  nav a[aria-current] { text-decoration: underline 3px var(--accent); text-underline-offset: 8px; }
  .sound {
    display: inline-flex; align-items: center; gap: 6px; min-height: var(--u4); padding: 0 var(--u1);
    color: var(--soft); background: none; border: 1px solid var(--line); font: 600 var(--b-small)/1 var(--font-body);
  }
  .sound[aria-pressed='true'] { color: var(--amber); border-color: var(--amber); }
  @media (max-width: 599px) {
    nav { order: 3; width: 100%; }
    ul { gap: 0 var(--u2); }
    nav a { font-size: 0.95rem; padding-block: 6px; }
    .sound span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
</style>
