---
import BrandIcon from './BrandIcon.astro';
import club from '../lib/club';

const links = [
  { href: club.discord, label: 'Discord', icon: 'discord' },
  { href: club.itch, label: 'itch.io', icon: 'itch' },
  { href: club.instagram, label: 'Instagram', icon: 'instagram' },
  { href: club.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: club.github, label: 'GitHub', icon: 'github' },
  { href: `mailto:${club.email}`, label: club.email, icon: 'mail' },
] as const;
---
<footer class="site-footer">
  <div class="wrap">
    <ul>
      {links.map((l) => (
        <li><a href={l.href}><BrandIcon name={l.icon} /><span>{l.label}</span></a></li>
      ))}
    </ul>
    <p class="small soft">
      © {new Date().getFullYear()} Glitch, IIT Hyderabad · Made with <span class="heart" aria-hidden="true">♥</span><span class="visually-hidden">love</span> by Lambda
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--u12); padding-block: var(--u6) var(--u4); background: var(--panel); border-top: 1px solid var(--line); }
  ul { display: flex; flex-wrap: wrap; gap: var(--u2) var(--u4); list-style: none; padding: 0; margin: 0 0 var(--u4); }
  a { display: inline-flex; align-items: center; gap: var(--u1); min-height: var(--u4); color: var(--text); font-weight: 700; text-decoration: none; }
  a:hover { color: var(--amber); }
  a :global(.brand) { width: 24px; height: 24px; color: var(--amber); }
  .heart { font-family: var(--font-pixel); color: var(--accent); }
</style>
