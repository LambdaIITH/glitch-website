---
// Pixel icons on an 11×11 grid ('#' = one pixel). At 22px each pixel is 2px, matching Departure Mono at 22px.
const icons = {
  arrow: [
    '...........',
    '...........',
    '......#....',
    '.......#...',
    '........#..',
    '.#########.',
    '........#..',
    '.......#...',
    '......#....',
    '...........',
    '...........',
  ],
  external: [
    '...........',
    '....######.',
    '........##.',
    '.......#.#.',
    '......#..#.',
    '.....#...#.',
    '....#....#.',
    '...#.......',
    '..#........',
    '.#.........',
    '...........',
  ],
  stairs: [
    '...........',
    '...........',
    '###........',
    '..#........',
    '..####.....',
    '.....#.....',
    '.....####..',
    '........#..',
    '........###',
    '...........',
    '...........',
  ],
  door: [
    '...........',
    '..#######..',
    '..#.....#..',
    '..#.....#..',
    '..#.....#..',
    '..#...#.#..',
    '..#.....#..',
    '..#.....#..',
    '..#.....#..',
    '..#.....#..',
    '###########',
  ],
  play: [
    '...........',
    '..##.......',
    '..###......',
    '..####.....',
    '..#####....',
    '..######...',
    '..#####....',
    '..####.....',
    '..###......',
    '..##.......',
    '...........',
  ],
  pause: [
    '...........',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '..##...##..',
    '...........',
  ],
  back: [
    '...........',
    '...........',
    '....#......',
    '...#.......',
    '..#........',
    '.#########.',
    '..#........',
    '...#.......',
    '....#......',
    '...........',
    '...........',
  ],
  // the player, as in every roguelike since Rogue; drawn here because the font's @ is too small to read at 22px
  at: [
    '...........',
    '...........',
    '...#####...',
    '..#.....#..',
    '..#.###.#..',
    '..#.#.#.#..',
    '..#.####...',
    '..#........',
    '...######..',
    '...........',
    '...........',
  ],
  die: [
    '...........',
    '.#########.',
    '.#.......#.',
    '.#.#...#.#.',
    '.#.......#.',
    '.#...#...#.',
    '.#.......#.',
    '.#.#...#.#.',
    '.#.......#.',
    '.#########.',
    '...........',
  ],
} as const;

export type IconName = keyof typeof icons;
interface Props { name: IconName; label?: string }
const { name, label } = Astro.props;

let d = '';
icons[name].forEach((row, y) => {
  for (const m of row.matchAll(/#+/g)) d += `M${m.index} ${y}h${m[0].length}v1h-${m[0].length}z`;
});
---
<svg class="icon" viewBox="0 0 11 11" width="22" height="22" fill="currentColor" shape-rendering="crispEdges"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}><path d={d} /></svg>
