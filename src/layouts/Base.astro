---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import display from '../fonts/big-shoulders-900.woff2?url';
import heading from '../fonts/work-sans-latin.woff2?url';
import body from '../fonts/atkinson-next-latin.woff2?url';
import hero2025 from '../assets/sprites/hero-2025.png';
import heroDrippi from '../assets/sprites/hero-drippi.png';
import heroCogito from '../assets/sprites/hero-cogito.png';
import heroPyro from '../assets/sprites/hero-pyrofrost.png';
import heroRow from '../assets/sprites/hero-rowmance.png';

interface Props {
  title?: string;
  description: string;
  current?: string;
  noindex?: boolean;
  /** An extra skip link placed first. */
  skip?: { href: string; label: string };
}
const { title, description, current, noindex = false, skip } = Astro.props;
// The logo's colour split, used on headings: a pink copy left and down, a cyan copy right and up, white where they
// overlap. Offsets are in pixels, so there is one filter per heading size (see global.css).
const splits = [1, 2, 3];
const fullTitle = title ? `${title} · Glitch` : 'Glitch, The Video Game Club of IITH';
// every game's hero, cut from the club's own builds and itch.io art, shown at 4x
const parade = [
  { src: hero2025, alt: '' }, { src: heroDrippi, alt: '' }, { src: heroCogito, alt: '' }, { src: heroPyro, alt: '' }, { src: heroRow, alt: '' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href={heading} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={body} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#141113" />
  </head>
  <body>
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      {splits.map((d) => (
        <filter id={`split-${d}`} color-interpolation-filters="sRGB" x="-5%" y="-10%" width="110%" height="120%">
          <feOffset in="SourceAlpha" dx={-d} dy={d / 4} result="a" />
          <feOffset in="SourceAlpha" dx={d} dy={-d / 4} result="b" />
          <feFlood flood-color="#e85070" /><feComposite in2="a" operator="in" result="pink" />
          <feFlood flood-color="#18f0f0" /><feComposite in2="b" operator="in" result="cyan" />
          <feComposite in="a" in2="b" operator="in" result="both" />
          <feFlood flood-color="#f8f8f8" /><feComposite in2="both" operator="in" result="white" />
          <feMerge><feMergeNode in="pink" /><feMergeNode in="cyan" /><feMergeNode in="white" /></feMerge>
        </filter>
      ))}
    </svg>
    {skip && <a class="skip-link" href={skip.href}>{skip.label}</a>}
    <a class="skip-link" href="#main">Skip to Content</a>
    <SiteHeader current={current} />
    <main id="main"><slot /></main>
    <SiteFooter />

    <template id="loader-template">
      <div class="loader" role="presentation">
        <p class="word glitch is-glitching" data-text="Glitch" aria-hidden="true">Glitch</p>
        <div class="parade" aria-hidden="true">
          {parade.map((p) => <img src={p.src.src} alt={p.alt} width={p.src.width * 4} height={p.src.height * 4} />)}
        </div>
        <div class="bar" aria-hidden="true"><span></span></div>
        <button type="button">Skip Intro</button>
      </div>
    </template>
    <script>
      import '../scripts/effects';
    </script>
  </body>
</html>

<style>
  main { min-height: 60vh; }
</style>
